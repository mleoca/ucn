<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Roslyn references below point at the SDK's OWN bundled compiler
    assemblies, so the helper must target the runtime of the SDK that builds
    it (a mismatch fails with CS1705). TargetFramework therefore follows the
    selected SDK's bundled runtime. global.json next to this file sets the
    floor (9.0) and rolls forward to the newest installed major; the oracle
    runs dotnet from this directory so the same SDK also restores and
    evaluates the target projects (newer target frameworks need it).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net$(BundledNETCoreAppTargetFrameworkVersion)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
